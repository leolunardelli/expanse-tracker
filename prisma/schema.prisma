// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth tables (NextAuth)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// User & Expenses
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for email/password auth
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  expenses      Expense[]
  budgets       Budget[]
  settings      UserSettings?
  incomes       Income[]
  plannedExpenses PlannedExpense[]
  customCategories CustomCategory[]
  passwordResetTokens PasswordResetToken[]
}

// User Settings & Preferences
model UserSettings {
  id                  String   @id @default(cuid())
  currency            String   @default("BRL")
  language            String   @default("en")
  budgetAlerts        Boolean  @default(true)
  weeklyReport        Boolean  @default(false)
  monthlyReport       Boolean  @default(true)
  aiInsightsEnabled   Boolean  @default(true)
  onboardingComplete  Boolean  @default(false)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Password Reset Tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expires   DateTime
  
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String
  date        DateTime @default(now())
  
  // Recurring expense fields
  isRecurring     Boolean @default(false)
  recurrenceType  String? // "daily", "weekly", "monthly", "yearly"
  
  // AI-generated fields
  aiCategory  String?  // AI-suggested category
  aiNote      String?  // AI insights
  
  // Tags & Notes
  tags        String[] @default([])
  notes       String?  // User notes/memo
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([date])
  @@index([category])
  @@index([isRecurring])
  @@index([tags])
}

// Budget Goals
model Budget {
  id          String   @id @default(cuid())
  category    String   // "all" for total budget, or specific category
  amount      Float    // Monthly budget limit
  period      String   @default("monthly") // monthly, weekly
  alertAt     Int      @default(80) // Alert when reaching this % (e.g., 80%)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, category]) // One budget per category per user
  @@index([userId])
}

// Income Sources
model Income {
  id          String   @id @default(cuid())
  description String   // "Salary", "Freelance", etc.
  amount      Float    // Gross amount per period
  type        String   @default("salary") // salary, freelance, investment, rental, other
  frequency   String   @default("monthly") // monthly, biweekly, weekly
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Custom Categories
model CustomCategory {
  id        String   @id @default(cuid())
  name      String   // Display name (e.g. "Investments")
  color     String   @default("#91919F") // Hex color
  icon      String   @default("Tag") // Lucide icon name

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

// Planned Monthly Expenses
model PlannedExpense {
  id          String   @id @default(cuid())
  description String   // "Rent", "Internet", "Groceries estimate"
  amount      Float    // Amount per period
  category    String   // Same categories as Expense
  frequency   String   @default("monthly") // monthly, weekly, yearly, daily
  isFixed     Boolean  @default(true) // fixed (rent) vs variable (food estimate)
  dueDay      Int?     // Day of month when due (1-31), optional
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}
